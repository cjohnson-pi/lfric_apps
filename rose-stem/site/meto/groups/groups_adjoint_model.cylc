{# Platform Generic Groups #}
{% do site_groups.update({
    "adjoint_model_developer": [
        "scripts",
        "adjoint_model_azspice_developer",
        "adjoint_model_ex1a_developer",
    ],
    "adjoint_model": [
        "adjoint_model_developer",
        "adjoint_model_azspice",
        "adjoint_model_ex1a",
    ],
    "adjoint_model_build": [
        "adjoint_model_azspice_build",
        "adjoint_model_ex1a_build",
    ],
    "adjoint_model_canned": [
        "adjoint_model_azspice_canned",
        "adjoint_model_ex1a_canned",
    ],
    }) %}

{# Platform Generic Extends #}
{% do site_groups.developer.extend(site_groups.adjoint_model_developer) %}
{% do site_groups.all.extend(site_groups.adjoint_model) %}
{% do site_groups.build.extend(site_groups.adjoint_model_build) %}

{# Azspice Extends #}
{% do site_groups.azspice_developer.extend(site_groups.adjoint_model_azspice_developer) %}
