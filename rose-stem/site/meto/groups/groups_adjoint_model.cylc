    ],
    "adjoint_model_azspice": [
        "adjoint_model_azspice_developer",
    ],
    "adjoint_model_azspice_build": [
        "build_adjoint_model_azspice_gnu_fast-debug-64bit",
        "build_adjoint_model_azspice_gnu_full-debug-64bit",
    ],
    "adjoint_model_azspice_canned": [
        "adjoint_model_canned_azspice_gnu_fast-debug-64bit",
    ],
    }) %}

{# EX1A Groups #}
{% do site_groups.update({
    "adjoint_model_ex1a_developer": [
        "adjoint_model_nwp_gal9-C12_MG_ex1a_gnu_fast-debug-64bit-rsolver64",
        "adjoint_model_nwp_gal9_zero-C12_MG_ex1a_gnu_fast-debug-64bit-rsolver64",
