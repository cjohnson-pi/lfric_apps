{% do LOG.debug("Entered site/common/adjoint_model/tasks_adjoint_model.cylc") %}

{% if task_ns.conf_name == "nwp_gal9-C12_MG" %}

    {% do task_dict.update({
        "opt_confs": ["nwp_gal9_c12"],
        "resolution": "C12_MG",
        "DT": 1800,
        "tsteps": 12,
        "mpi_parts": 1,
        "log_level": "debug",
        "plot_str": "linear.py $NODAL_DATA_DIR/lfric_diag.nc $PLOT_DIR 70 linear_model-nwp-gal9 theta:exner:rho:u_in_w2h:v_in_w2h:w_in_wth:m_v:m_cl:m_r:m_s 120:0:5",
    }) %}

{% elif task_ns.conf_name == "nwp_gal9_zero-C12_MG" %}

    {% do task_dict.update({
        "opt_confs": ["nwp_gal9_c12","zero"],
        "resolution": "C12_MG",
        "DT": 1800,
        "tsteps": 12,
        "mpi_parts": 1,
        "plot_str": "linear.py $NODAL_DATA_DIR/lfric_diag.nc $PLOT_DIR 70 linear_model-nwp-gal9_random theta:exner:rho:u_in_w2h:v_in_w2h:w_in_wth:m_v:m_cl:m_r:m_s 120:0:5",
    }) %}

{% elif task_ns.conf_name == "semi-implicit-C12" %}

    {% do task_dict.update({
        "opt_confs": ["semi-implicit"],
        "resolution": "C12",
        "DT": 10,
        "tsteps": 100,
        "mpi_parts": 1,
        "log_level":"debug",
        "plot_str": "linear.py $NODAL_DATA_DIR/lfric_diag.nc $PLOT_DIR 5 linear_model-semi-implicit rho 120:0:3"
    }) %}

{% elif task_ns.conf_name == "canned" %}

    {% do task_dict.update({
        "app_name": "canned_test",
        "kgo_checks": [],
    }) %}

{% elif task.startswith("build") %}

    {% do task_dict.update({
        "placeholder": true,
    }) %}

{% endif %}


{# Set default values for Adjoint Model tasks #}
{% if task_dict %}
    {% do task_dict.update({"application_dir": "apps/applications/adjoint_model"}) %}
    {% if "app_name" not in task_dict %}
        {% do task_dict.update({"app_name": "adjoint_model"}) %}
    {% endif %}
    {% if "kgo_checks" not in task_dict %}
        {% do task_dict.update({"kgo_checks": "checksum"}) %}
    {% endif %}
{% endif %}

{% do LOG.debug("Finished in site/common/linear_model/tasks_adjoint_model.cylc") %}
